# Copy to .env and fill in. `adk web` / `adk run` auto-load .env.

# --- Model / platform -------------------------------------------------------
# Gemini 3.x resolves only on the Vertex `global` endpoint; the model factory
# (financial_support/model.py) routes it there automatically while the platform
# services below stay REGIONAL via GOOGLE_CLOUD_LOCATION.
MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Active case (keeps the running agent scoped to one case) ---------------
# 1 = evaluation/invariants only (Case 1 demo). 2 adds resilience, 3 adds
# zero-trust — later cases' callbacks stay dormant until you raise this.
CASE=1

# --- Demo scenario (deterministic fault injection) --------------------------
# One of: healthy | refund_over_charge | wrong_account | slow_payment |
#         payment_declined | fraud_unavailable
SCENARIO=healthy

# Ad-hoc override on top of the scenario, e.g.:
# FAULTS_JSON={"issue_refund": {"latency_s": 15}}

# --- Invariant seam (Case 1) ------------------------------------------------
# observe: let the wrong action stand so the eval catches it (demo default).
# block:   the runtime callback refuses the action (defense in depth).
INVARIANT_ENFORCEMENT=observe

# --- Observability ----------------------------------------------------------
TELEMETRY_ENABLED=true
OTEL_TO_CLOUD=false

# --- A2A fraud-check --------------------------------------------------------
# false: use the local fraud_check tool (offline).
# true:  call the external fraud agent over A2A (start it with
#        `uv run python -m fraud_check_a2a`).
USE_A2A_FRAUD=false
FRAUD_AGENT_URL=http://localhost:8001
