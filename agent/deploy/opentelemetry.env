# OpenTelemetry configuration for the ADK agent (the Case 1 substrate).
#
#   uv run --env-file deploy/opentelemetry.env adk web --otel_to_cloud
#
# Exports gen_ai.* spans to Cloud Trace — the same substrate the Evaluation
# Service reads. Message content is kept OUT of spans (PII) and, if needed, sent
# to Cloud Storage instead.

OTEL_SERVICE_NAME=financial-support-agent
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Keep raw prompts/responses out of the span (avoid PII in traces).
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Multimodal / large payloads -> Cloud Storage (set BUCKET/PATH for your project).
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://BUCKET/PATH
